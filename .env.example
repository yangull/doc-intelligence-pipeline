# Copy to .env and fill in. `.env` is gitignored; this template is not.
#   cp .env.example .env

AWS_REGION=eu-west-1
APP_ENV=development
LOG_LEVEL=INFO

S3_BUCKET_NAME=doc-intelligence-documents-dev
DYNAMODB_TABLE_NAME=doc-intelligence-documents-dev
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# Required — these have no defaults and the app refuses to start without them.
# Read them from `terraform output` after an apply.
SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/<account-id>/doc-intelligence-documents-dev
BEDROCK_KB_ID=<knowledge-base-id>
BEDROCK_KB_DATA_SOURCE_ID=<data-source-id>

# Optional. An empty API_KEY disables auth entirely, which is what you want for
# local development. In AWS it is injected from SSM, never set here.
API_KEY=
# Empty means wildcard CORS; browsers only accept that without credentials.
CORS_ALLOW_ORIGINS=

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
